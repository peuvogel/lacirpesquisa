node_modules/
dist/
.DS_Store
*.log
.env
.env.local
*.tsbuildinfo

# Large reference / generated artifacts (keep out of git unless needed)
jasp-desktop-development/
trabalhos datasus/build/
trabalhos datasus/outputs/
trabalhos datasus/spreadsheet_work/
trabalhos datasus/tools/
trabalhos datasus/Congresso Vascular/

